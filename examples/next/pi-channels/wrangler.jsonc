{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pi-channels-spike",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [{ "name": "PiChannelsAgent", "class_name": "PiChannelsAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PiChannelsAgent"] }]
}
