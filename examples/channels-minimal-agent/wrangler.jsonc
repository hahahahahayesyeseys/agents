{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "channels-minimal-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/channels/*"]
  },
  "durable_objects": {
    "bindings": [{ "class_name": "MinimalAgent", "name": "MinimalAgent" }]
  },
  "migrations": [{ "new_sqlite_classes": ["MinimalAgent"], "tag": "v1" }]
}
